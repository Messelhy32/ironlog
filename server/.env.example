# Copy to .env and fill in.
PORT=8787
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/ironlog?retryWrites=true&w=majority
CORS_ORIGINS=https://ironlog-app.pages.dev,http://localhost:5173
TOKEN_TTL_DAYS=30
# Set to "true" on first deploy to auto-run the seeder, then remove.
SEED_ON_START=false
# Initial user/password used by the seeder (only on first run).
SEED_USERNAME=me
SEED_PASSWORD=1307
